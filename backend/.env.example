# Postgres. SSL is required; DB_SSLMODE defaults to "require" so it is usually omitted.
#
# Supabase: use the SESSION POOLER connection (dashboard -> Connect -> Session pooler),
# not the direct connection. Three things catch people out:
#   1. db.<project-ref>.supabase.co resolves to IPv6 only. If your network has no IPv6
#      egress you get "Network is unreachable" — the pooler host has IPv4, so use it.
#   2. DB_NAME is always "postgres". The project ref goes in the username, not here.
#   3. The pooler username is "postgres.<project-ref>", not plain "postgres".
# Use session mode (port 5432), not transaction mode (6543): the latter breaks psycopg's
# prepared statements unless prepare_threshold=None is set on the pool in db.py.
#
# Values are a hostname, not a URL — no "https://" prefix.
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=your-db-password
# DB_SSLMODE=require

# ExerciseDB (RapidAPI "EDB with videos and images by ascendapi")
EDB_KEY=your-rapidapi-key

# Auth. Generate a long random value, and use a DIFFERENT one in production than locally.
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_DAYS=7

# Gemini
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# Server.
# PORT: leave unset on a PaaS — Railway/Render inject it and the Dockerfile reads ${PORT:-8000}.
# FRONTEND_ORIGIN: exact origins allowed by CORS, comma-separated. No wildcards, no trailing
# slash. In production this must be the deployed frontend URL (e.g. https://fitcoach.vercel.app),
# otherwise the browser blocks every API call.
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
